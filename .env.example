# Copy to .env and fill in. Consumed by provision_ssh.py (and the Vite dev server).
SEMAPHORE_URL=https://cicd-ucaas.mycountrymobile.com
SEMAPHORE_TOKEN=your-semaphore-api-token

# Optional: reuse an existing project / key instead of creating them.
# SEMAPHORE_PROJECT_ID=6
# SSH_KEY_ID=303

# Provisioning inputs.
TARGET_HOSTS=10.0.0.5,10.0.0.6
BOOTSTRAP_USER=root
# BOOTSTRAP_SSH_KEY=~/.ssh/id_ed25519
TARGET_USER=root
# NEW_PUBLIC_KEY=~/.ssh/new_key.pub

# Playbook source (defaults to a generated local git repo if unset).
# REPO_GIT_URL=https://github.com/techcapanicus/glowing-goggles.git
# REPO_BRANCH=main
# PLAYBOOK=ansible/provision_ssh.yml
