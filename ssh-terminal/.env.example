# Copy this file to .env and fill in real values. .env is gitignored.

# HTTP server for this webapp
PORT=3001
HOST=0.0.0.0

# Target host this webapp bridges browser terminals to via SSH
SSH_HOST=172.174.232.34
SSH_PORT=22
SSH_USER=adminuser
SSH_PASSWORD=changeme

# Password the browser must enter before the server opens the SSH session.
# Strongly recommended for anything reachable outside of localhost.
# Leave blank to disable this extra prompt.
APP_PASSWORD=
